# 복사해서 .env.local로 저장하고 값을 채운다 (Supabase 대시보드 → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://<프로젝트 ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>
# 서버 전용. 절대 NEXT_PUBLIC_ 을 붙이지 않는다
SUPABASE_SERVICE_ROLE_KEY=<service_role secret key>
# 배포 주소 (카톡 미리보기 이미지 등 절대 주소에 사용). 로컬은 비워둬도 된다
NEXT_PUBLIC_SITE_URL=https://hid-stageflow.vercel.app
